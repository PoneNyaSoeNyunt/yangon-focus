APP_NAME="Yangon Focus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-app-url.onrender.com
FRONTEND_URL=https://your-frontend-url.onvercel.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yangon_focus_local
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/var/www/html/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

MAIL_MAILER=log